void loop() {


  unsigned long currentTime = millis();
  dt = (currentTime - lastTime) / 1000.0;
  if (dt <= 0.0) dt = 0.001;
  lastTime = currentTime;

  Wire.beginTransmission(MPU_addr);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_addr, 14, true);



  AcX = Wire.read() << 8 | Wire.read();
  AcY = Wire.read() << 8 | Wire.read();
  AcZ = Wire.read() << 8 | Wire.read();
  Tmp = Wire.read() << 8 | Wire.read();
  GyX = Wire.read() << 8 | Wire.read();
  GyY = Wire.read() << 8 | Wire.read();
  GyZ = Wire.read() << 8 | Wire.read();

  gyroRollRate = GyX / 131.0;
  gyroPitchRate = GyY / 131.0;

  float accRoll = atan2(AcY, sqrt(pow(AcX, 2) + pow(AcZ, 2))) * 180 / M_PI;
  float accPitch = atan2(-AcX, sqrt(pow(AcY, 2) + pow(AcZ, 2))) * 180 / M_PI;

  //filter
  rollAngle = 0.96 * (rollAngle + gyroRollRate * dt) + 0.04 * accRoll;
  pitchAngle = 0.96 * (pitchAngle + gyroPitchRate * dt) + 0.04 * accPitch;

  errorRoll = setpointRoll - rollAngle;
  IRoll += errorRoll * dt;
  IRoll = constrain(IRoll, -50, 50);
  DRoll = (errorRoll - lastErrorRoll) / dt;
  pidOutputRoll = (kp * errorRoll) + (ki * IRoll) + (kd * DRoll);
  lastErrorRoll = errorRoll;

  errorPitch = setpointPitch - pitchAngle;
  IPitch += errorPitch * dt;
  IPitch = constrain(IPitch, -50, 50);
  DPitch = (errorPitch - lastErrorPitch) / dt;
  pidOutputPitch = (kp * errorPitch) + (ki * IPitch) + (kd * DPitch);
  lastErrorPitch = errorPitch;

  // ================================================================
  // [ADD] VL53L0X 高さ読み取り, 高さホールドP, 自動着陸判定
  // ================================================================
  static bool has_achieved_altitude = false;  // Latch to prevent auto-land on takeoff

  // WAKE UP FROM LANDED: If throttle is pushed up (and esp-now actually connected), reset to FLYING
  if (flight_state == LANDED && espnow_received_flag && receivedData.vertical > 10) {
    flight_state = FLYING;
    has_achieved_altitude = false;
    Serial.println("Throttle up -> Taking off, state set to FLYING");
  }

  // [ADD] VL53L0X 常駐起動：失敗しても 1 秒毎に再初期化を試行
  if (!vl53l0x_ok) {
    if ((long)(millis() - vl53l0x_next_retry_ms) >= 0) {
      if (vl53l0x_init_once()) {
        vl53l0x_ok = true;
        vl53l0x_timeout_cnt = 0;
        vl53l0x_ever_read_ok = false;
        Serial.println("VL53L0X retry -> initialized OK");
      } else {
        vl53l0x_ok = false;
      }
      vl53l0x_next_retry_ms = millis() + VL53L0X_RETRY_INTERVAL_MS;
    }
  }
  height_correction = 0.0f;
  if (vl53l0x_ok) {
    uint16_t dist = sensor.readRangeContinuousMillimeters();
    bool tmo = sensor.timeoutOccurred();
    tof_last_timeout = tmo;
    
    if (tmo) {
      vl53l0x_timeout_cnt++;
      if (vl53l0x_timeout_cnt >= VL53L0X_TIMEOUT_MAX) {
        vl53l0x_ok = false;
        vl53l0x_next_retry_ms = millis() + VL53L0X_RETRY_INTERVAL_MS;
        // [セーフランド無効コメント]
        //if (flight_state == FLYING) {
        //  land_start_ms = millis();
        //  flight_state  = DESCENDING;
        //  Serial.println("VL53L0X TIMEOUT -> safety auto landing start");
        //}
      }
    } else {
      vl53l0x_timeout_cnt = 0;
      current_height_mm   = dist;
      vl53l0x_ever_read_ok = true;

      // Track if we have successfully taken off (above 150mm)
      if (current_height_mm > 150) {
          has_achieved_altitude = true;
      }


      // [セーフランド無効コメント]
      //if (flight_state == FLYING && has_achieved_altitude && current_height_mm <= SAFETY_DESCEND_MM) {
      //  land_start_ms    = millis();
      //  flight_state     = DESCENDING;
      //  target_height_mm = 30;
      //  Serial.printf("SAFETY: unexpected drop (%umm) -> auto landing\n", current_height_mm);
      //}

      if (flight_state != LANDED) {
        long  err_h = (long)current_height_mm - (long)target_height_mm;
        float corr  = HEIGHT_KP * (float)err_h;
        height_correction = constrain(corr, -60.0f, +80.0f);
      }
    }
  } else {
    tof_last_timeout = false;
  }

  // [セーフランド無効コメント]
  //if (flight_state == DESCENDING) {
  //  unsigned long t = millis() - land_start_ms;
  //  float frac = (t >= LAND_DURATION_MS) ? 1.0f : (float)t / (float)LAND_DURATION_MS;
  //  float land_thrust = -8.0f - frac * 60.0f;
  //
  //  // CHANGED: LAND_TRIGGER_MM should be much lower (e.g., 40mm) since your ground reading is 30-100
  //  if (vl53l0x_ok && current_height_mm <= 40) {
  //    flight_state = LANDED;
  //    Serial.printf("LANDED (height %umm <= 40mm) -> motors off\n", current_height_mm);
  //  } else if (t >= LAND_DURATION_MS) {
  //    flight_state = LANDED;
  //    Serial.println("LANDED (timeout) -> motors off");
  //  } else {
  //    if (land_thrust < height_correction) height_correction = land_thrust;
  //  }
  //}
  // ================================================================

  float base_throttle_f = (float)receivedData.vertical + (float)THROTTLE_IDLE_OFFSET - 30;
  //高さ補正 / 着陸済み時は強制 0
  float effective_throttle_f = base_throttle_f + height_correction;
  if (flight_state == LANDED) effective_throttle_f = 0.0f;
  //mpu
  int16_t m1i = (int16_t)(effective_throttle_f - pidOutputRoll - pidOutputPitch);
  int16_t m3i = (int16_t)(effective_throttle_f - pidOutputRoll + pidOutputPitch); 
  int16_t m2i = (int16_t)(effective_throttle_f + pidOutputRoll - pidOutputPitch);
  int16_t m4i = (int16_t)(effective_throttle_f + pidOutputRoll + pidOutputPitch); 

  // PMW3901 draft
  // flow.readMotionCount(&deltaX, &deltaY);
  // if (deltaY < -50) { 
  //   m1i -= 20; 
  //   m2i -= 20; 
  // }
  // if (deltaY > 50) { 
  //   m3i -= 20; 
  //   m4i -= 20; 
