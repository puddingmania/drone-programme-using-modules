void setup() {
  Serial.begin(115200);
  delay(1509);  // stable the serial

  //pmw3901
  SPI.begin();
  flow.begin();

  //I2C バスロック回復 & 先にタイムアウト設定 (SDA=21/SCL=22 は ESP32標準)
  i2cBusRecover(21, 22);
  //mpu
  Wire.begin();
  Wire.setTimeOut(50);  // 50msでタイムアウト
  delay(5);
  Wire.beginTransmission(MPU_addr);
  Wire.write(0x6B);
  Wire.write(0);
  Wire.endTransmission(true);

  // Wi-Fi設定
  WiFi.mode(WIFI_AP_STA);  // requires the Wi-Fi radio to be on
  Serial.print("MAC Address: ");
  Serial.println(WiFi.macAddress());

  // initialize
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  // important v3 feedback
  esp_now_register_recv_cb(esp_now_recv_cb_t(OnDataRecv));


  //vl53l0x
 // MPU6050の初期化後...

  // VL53L0Xの初期化（共通関数利用、初回失敗時は1秒毎にloop内で再試行=常駐起動）
  if (vl53l0x_init_once()) {
    vl53l0x_ok = true;
    vl53l0x_timeout_cnt = 0;
  } else {
    vl53l0x_ok = false;
    vl53l0x_next_retry_ms = millis() + VL53L0X_RETRY_INTERVAL_MS;
  }

  // ESC 初期化 (ESP32Servo: 50Hz / 1-2ms 標準パルス)
// ESC 初期化 (ESP32Servo: 50Hz / 1-2ms 標準パルス)
  ESP32PWM::allocateTimer(-1);
  

  m1s.setPeriodHertz(50); // Standard 50Hz ESC
  m2s.setPeriodHertz(50);
  m3s.setPeriodHertz(50);
  m4s.setPeriodHertz(50);


  m1s.attach(33, ESC_US_MIN, ESC_US_MAX);
  m2s.attach(25, ESC_US_MIN, ESC_US_MAX);
  m3s.attach(32, ESC_US_MIN, ESC_US_MAX);
  m4s.attach(26, ESC_US_MIN, ESC_US_MAX);

  //Send MIN throttle (1000us) first to arm the ESCs
  Serial.print("Arming ESCs (Waiting 3s)... ");
  m1s.writeMicroseconds(ESC_US_MIN);
  m2s.writeMicroseconds(ESC_US_MIN);
  m3s.writeMicroseconds(ESC_US_MIN);
  m4s.writeMicroseconds(ESC_US_MIN);
  delay(3000); // Give the ESCs time to boot, read 0 throttle, and beep their armed sequence
  Serial.println("Armed.");

  //test
  const int ESC_US_TEST = ESC_US_MIN + (ESC_US_MAX - ESC_US_MIN) * 60 / 100;
