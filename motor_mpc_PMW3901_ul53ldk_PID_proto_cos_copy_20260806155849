  // if (deltaX < -50) { 
  //   m2i -= 20; 
  //   m4i -= 20; 
  // }
  // if (deltaX > 50) { 
  //   m1i -= 20; 
  //   m3i -= 20; 
  // }

  if (receivedData.rotate > 125) {
    // ヨー回転（CWペアを下げる）: これは元のままで正解です
    int16_t reducePower = (int16_t)map(receivedData.rotate, 125, 255, 0, 80);  
    m2i -= reducePower; 
    m3i -= reducePower; 
  } else if (receivedData.rotate < 115) {
    // ヨー回転（CCWペアを下げる）: これは元のままで正解です
    int16_t reducePower = (int16_t)map(receivedData.rotate, 115, 0, 0, 80);  
    m1i -= reducePower; 
    m4i -= reducePower; 
  }

  if (receivedData.frontback > 125) {
    // 前進: 前モーター(1と2)の出力を下げる
    int16_t reducePower = (int16_t)map(receivedData.frontback, 125, 255, 0, 80);  
    m2i -= reducePower;                                                            
    m4i -= reducePower;                                                            
  } else if (receivedData.frontback < 115) {
    // 後退: 後モーター(3と4)の出力を下げる
    int16_t reducePower = (int16_t)map(receivedData.frontback, 115, 0, 0, 80);  
    m1i -= reducePower;
    m3i -= reducePower;
  }




  //remains +values & LANDED 最終保証
  int m1, m2, m3, m4;
  if (flight_state == LANDED) {
    m1 = m2 = m3 = m4 = 0;
  } else {
    m1 = constrain((int)m1i, MOTOR_MIN, MOTOR_MAX);
    m2 = constrain((int)m2i, MOTOR_MIN, MOTOR_MAX);
    m3 = constrain((int)m3i, MOTOR_MIN, MOTOR_MAX);
    m4 = constrain((int)m4i, MOTOR_MIN, MOTOR_MAX);
  }

  if (Serial.available() > 0) { // データが届いているか確認
    char incomingChar = Serial.read(); // 1文字読み込む
    
    // 受け取った文字に応じた操作
    if (incomingChar == '0') {
      m1 = 0;
      m2 = 0;
      m3 = 0;
      m4 = 0;
      delay(999999);
    }
  }


  //output part (ESC 1000-2000us, 元の0-100スケールを線形変換)
  m1s.writeMicroseconds(map(m1, MOTOR_MIN, MOTOR_MAX, ESC_US_MIN, ESC_US_MAX));
  m2s.writeMicroseconds(map(m2, MOTOR_MIN, MOTOR_MAX, ESC_US_MIN, ESC_US_MAX));
  m3s.writeMicroseconds(map(m3, MOTOR_MIN, MOTOR_MAX, ESC_US_MIN, ESC_US_MAX));
  m4s.writeMicroseconds(map(m4, MOTOR_MIN, MOTOR_MAX, ESC_US_MIN, ESC_US_MAX));

  Serial.print("Roll: ");
  Serial.print(rollAngle);
  Serial.print(" | Pitch: ");
  Serial.print(pitchAngle);
  Serial.print(" | pidOutputPitch: ");
  Serial.print(pidOutputPitch);
  Serial.print(" | pidOutputRoll: ");
  Serial.print(pidOutputRoll);
  Serial.print(" | M1: ");
  Serial.print(m1);
  Serial.print(" | M2: ");
  Serial.print(m2);
  Serial.print(" | M3: ");
  Serial.print(m3);
  Serial.print(" | M4: ");
  Serial.println(m4);
  Serial.print("X: ");
  Serial.print(deltaX);
  Serial.print("| Y: ");
  Serial.print(deltaY);

  if (vl53l0x_ok) {
    Serial.print(current_height_mm);
  }
  if (tof_last_timeout) { Serial.print(" TIMEOUT"); }

  // Serial.println();
  // Serial.print("# Height cur=");
  // Serial.print(current_height_mm);
  // Serial.print(" target=");
  // Serial.print(target_height_mm);
  // Serial.print(" state=");
  // Serial.print(flight_state == FLYING ? "FLYING" : flight_state == DESCENDING ? "DESCENDING"
