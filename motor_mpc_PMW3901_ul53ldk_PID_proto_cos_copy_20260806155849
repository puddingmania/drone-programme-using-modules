void processSerialCommand() {
  static char cmd_buf[96];
  static uint8_t cmd_len = 0;
  static bool cmd_overflow = false;
  while (Serial.available()) {
    char c = (char)Serial.read();
    if (c == '\r') continue;
    if (c != '\n') {
      if (!cmd_overflow && cmd_len < (int)sizeof(cmd_buf) - 1) cmd_buf[cmd_len++] = c;
      else cmd_overflow = true;
      continue;
    }
    if (cmd_overflow) {
      cmd_len = 0;
      cmd_overflow = false;
      continue;
    }
    cmd_buf[cmd_len] = '\0';
    cmd_len = 0;
    if (cmd_buf[0] == '\0') continue;
    String cmd = String(cmd_buf);
    cmd.trim();
    if (cmd.length() == 0) continue;

    if (cmd.startsWith("SET ") || cmd.startsWith("PID")) {
      String params = cmd.substring(3);
      params.trim();
      float new_kp = kp, new_ki = ki, new_kd = kd;
      bool ok = false;
      if (params.indexOf(":") >= 0) {
        int p = params.indexOf("P:"), i = params.indexOf("I:"), d = params.indexOf("D:");
        if (p >= 0) {
          int e = params.indexOf(" ", p + 2);
          if (e < 0) e = params.length();
          new_kp = params.substring(p + 2, e).toFloat();
        }
        if (i >= 0) {
          int e = params.indexOf(" ", i + 2);
          if (e < 0) e = params.length();
          new_ki = params.substring(i + 2, e).toFloat();
        }
        if (d >= 0) {
          int e = params.indexOf(" ", d + 2);
          if (e < 0) e = params.length();
          new_kd = params.substring(d + 2, e).toFloat();
        }
        ok = (p >= 0) || (i >= 0) || (d >= 0);
      } else {
        int s1 = params.indexOf(" "), s2 = params.lastIndexOf(" ");
        if (s1 > 0 && s2 > s1) {
          new_kp = params.substring(0, s1).toFloat();
          new_ki = params.substring(s1 + 1, s2).toFloat();
          new_kd = params.substring(s2 + 1).toFloat();
          ok = true;
        }
      }
      if (!ok) {
        Serial.println("ERROR: PID format");
        continue;
      }
      const float KP_MAX = 100, KI_MAX = 50, KD_MAX = 50;
      if (new_kp > 0 && new_kp <= KP_MAX && new_ki >= 0 && new_ki <= KI_MAX && new_kd >= 0 && new_kd <= KD_MAX) {
        kp = new_kp;
        ki = new_ki;
        kd = new_kd;
        IRoll = IPitch = lastErrorRoll = lastErrorPitch = 0;
        Serial.printf("PID Updated: P=%.3f I=%.3f D=%.3f\n", kp, ki, kd);
      } else Serial.println("ERROR: PID out of range");
    } else if (cmd.startsWith("SET HEIGHT:")) {
      String v = cmd.substring(11);
      v.trim();
      long h = v.toInt();
      if (h >= 20 && h <= 4000) {
        target_height_mm = (uint16_t)h;
        flight_state = FLYING;
        land_start_ms = 0;
        Serial.printf("SET HEIGHT -> Target=%umm\n", target_height_mm);
      } else Serial.println("ERROR: HEIGHT must be 20..4000 mm");
    } else if (cmd == "LAND") {
      land_start_ms = millis();
      flight_state = DESCENDING;
      target_height_mm = 10;
      Serial.println("LAND command -> soft landing start");
    } else if (cmd == "HOVER") {
      if (vl53l0x_ok && current_height_mm >= 20) target_height_mm = current_height_mm;
      flight_state = FLYING;
      land_start_ms = 0;
      Serial.printf("HOVER -> target=%umm\n", target_height_mm);
    } else if (cmd == "STATUS") {
      Serial.printf("STATUS: state=%s Roll=%.2f Pitch=%.2f Height=%u/%umm PID=%.3f/%.3f/%.3f\n",
                    flight_state == FLYING ? "FLYING" : flight_state == DESCENDING ? "DESC"
                                                                                   : "LANDED",
                    rollAngle, pitchAngle,
                    vl53l0x_ok ? current_height_mm : (uint16_t)0xFFFF, target_height_mm,
                    kp, ki, kd);
    } else if (cmd == "RESET") {
      kp = 1.5;
      ki = 0.06;
      kd = 0.5;
      IRoll = IPitch = lastErrorRoll = lastErrorPitch = 0;
      target_height_mm = 500;
      flight_state = FLYING;
      land_start_ms = 0;
      Serial.println("System Reset");
    }
  }
}

// ================================================================
// [ADD] VL53L0X 共通初期化関数 (setup + 常駐再試行の両方から呼ばれる)
//        true = 初期化成功, false = ACKまたはinit失敗
// ================================================================
bool vl53l0x_init_once() {
  Wire.beginTransmission(0x29);
  uint8_t tof_ack = Wire.endTransmission(true);
  if (tof_ack != 0) {
    Serial.printf("VL53L0X 0x29 no ACK (err=%u)\n", tof_ack);
    return false;
  }
  if (!sensor.init()) {
    Serial.println("VL53L0X init() failed");
    return false;
  }
  sensor.setTimeout(100);
  sensor.startContinuous((uint32_t)VL53L0X_MEASURE_PERIOD_MS);
  // startContinuous 起動直後のダミー読み捨て (データシート推奨)
  (void)sensor.readRangeContinuousMillimeters();
  (void)sensor.timeoutOccurred();
  Serial.println("VL53L0X initialized OK");
  return true;
}
